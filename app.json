{
  "cron": [
    {"schedule": "2-59/5  *        * * *", "command": "python manage.py retry_deferred"},
    {"schedule": "23      0        * * *", "command": "python manage.py purge_mail_log 180"}
  ],
  "healthchecks": {
    "web": [
      {
        "type": "startup",
        "name": "web home check",
        "description": "Check /home",
        "path": "/home",
        "content": "O Brasil em dados libertos",
        "initialDelay": 10,
        "timeout": 15,
        "attempts": 3
      },
      {
        "type": "startup",
        "name": "web colabore check",
        "description": "Check /colabore",
        "path": "/colabore",
        "content": "Colabore - ",
        "initialDelay": 10,
        "timeout": 15,
        "attempts": 3
      },
      {
        "type": "startup",
        "name": "web datasets check",
        "description": "Check /datasets",
        "path": "/datasets",
        "content": "Lista de datasets - ",
        "initialDelay": 10,
        "timeout": 15,
        "attempts": 3
      }
    ]
  }
}
